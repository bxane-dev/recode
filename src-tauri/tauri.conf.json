{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recode",
  "version": "0.3.0",
  "identifier": "dev.bxane.recode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Recode",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "bxane-dev",
    "category": "Utility",
    "shortDescription": "Offline single-player game trainer toolkit",
    "longDescription": "Open-source memory scanner and trainer builder for offline and single-player games.",
    "copyright": "Copyright © 2026 bxane-dev",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Recode",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
